# Copy this file to .env for local emulator use only.
# Do not commit real Quran.Foundation credentials.

QF_ENV=preproduction

# Use the pre-production values first. Keep production values out of local dev
# unless you are preparing a release.
QF_CLIENT_ID=replace-with-preproduction-client-id
QF_CLIENT_SECRET=replace-with-preproduction-client-secret
QF_CONTENT_BASE_URL=replace-with-preproduction-content-api-endpoint
QF_TOKEN_URL=replace-with-preproduction-oauth-token-endpoint

# Optional. Defaults to "content".
QF_SCOPE=content
